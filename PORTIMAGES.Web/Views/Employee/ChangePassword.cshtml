 @using System.Security.Claims
@{
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
} 
<div class="main-content-container overflow-hidden">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
        <h5 class="mb-0">Change Password</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb align-items-center mb-0 lh-1">
                <li class="breadcrumb-item">
                    <a href="~/Admin/Dashboard" class="d-flex align-items-center text-decoration-none">
                        <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                        <span class="text-body fs-14 hover">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>Change Password</span>
                </li>
            </ol>
        </nav>
    </div>
    <div class="row">
        <div class="col-xxl-12 col-lg-12 col-md-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Old Password<span class="text-danger"> *</span></label>
                                <div class="position-relative">
                                    <input type="password" class="form-control pe-5" id="txtOldPwd_CP" placeholder="Old Password">
                                    <i class="ti ti-eye password-toggle" data-target="txtOldPwd_CP"></i>
                                </div>
                                @* <input type="password" class="form-control" id="txtOldPwd_CP" placeholder="Old Password"> *@
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">New Password<span class="text-danger"> *</span></label>
                                <div class="position-relative">

                                    <input type="password"
                                           class="form-control pe-5"
                                           id="txtNewPwd_CP"
                                           placeholder="New Password">

                                    <i class="ti ti-eye password-toggle"
                                       data-target="txtNewPwd_CP"></i>

                                </div>
                                @* <input type="password" class="form-control" id="txtNewPwd_CP" placeholder="New Password"> *@
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Confirm Password<span class="text-danger"> *</span></label>
                                <div class="position-relative">

                                    <input type="password"
                                           class="form-control pe-5"
                                           id="txtConfirmPwd_CP"
                                           placeholder="Confirm Password">

                                    <i class="ti ti-eye password-toggle"
                                       data-target="txtConfirmPwd_CP"></i>

                                </div>
                                @* <input type="password" class="form-control" id="txtConfirmPwd_CP" placeholder="Confirm Password"> *@
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-xs btn-danger fw-normal text-white" id="btnClear_CP">Clear</button>
                    <button type="button" class="btn btn-xs btn-primary fw-normal text-white" id="btnChangePassword">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common/helper.js"></script>
    <script>
        function validateProduct() {
            if (!validateRequired("txtOldPwd_CP", ["", " "], "Old password is required")) return false;
            if (!validateRequired("txtNewPwd_CP", ["", "-1"], "New password is required")) return false;
            if (!validateRequired("txtConfirmPwd_CP", ["", " ", "0"], "Confirm password is required")) return false;

            let newPwd = $("#txtNewPwd_CP").val();
            let confirmPwd = $("#txtConfirmPwd_CP").val();
            if (newPwd !== confirmPwd) {
                $("#txtConfirmPwd_CP").addClass("input-error");
                $("#txtConfirmPwd_CP").after('<small class="text-danger error-text">Passwords do not match</small>');
                return false;
            }

            return true;
        }

        $(document).on("input change", "#txtOldPwd_CP,#txtNewPwd_CP,#txtConfirmPwd_CP", function () {
            $(this).removeClass("input-error");
            $(this).next(".error-text").remove();
        });

        $(document).on("click", "#btnChangePassword", function () {
            if (!validateProduct()) return;
            let payload = {
                oldPassword: $("#txtOldPwd_CP").val().trim(),
                newPassword: $("#txtNewPwd_CP").val().trim(),
                confirmPassword: $("#txtConfirmPwd_CP").val().trim()
            };
            let _url = "/Employee/ChangePassword";
            $.ajax({
                url: _url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {

                    let type =
                        res.status === 1 ? "success" :
                            res.status === 2 || res.status === 3 ? "warning" :
                                "error";

                    let title =
                        res.status === 1 ? "Success" :
                            res.status === 2 ? "Invalid Password" :
                                res.status === 3 ? "Password Mismatch" :
                                    "Error";

                    ShowToast(type, title, res.message);

                    if (res.status === 1) {
                        resetForm_ChangePassword();
                    }
                }
            });

        });

        $(document).on("click", "#btnClear_CP", function () {
            resetForm_ChangePassword();
        });

        function resetForm_ChangePassword() {
            $("#txtOldPwd_CP,#txtNewPwd_CP,#txtConfirmPwd_CP").val("");
            $("#txtOldPwd_CP,#txtNewPwd_CP,#txtConfirmPwd_CP").attr("type", "password");
            $(".password-toggle").removeClass("ti-eye-off").addClass("ti-eye");
            $(".input-error").removeClass("input-error");
            $(".error-text").remove();
        }

        $(document).on("click", ".password-toggle", function () {
            let target = $(this).data("target");
            let input = $("#" + target);
            let type = input.attr("type");
            if (type === "password") {
                input.attr("type", "text");
                $(this).removeClass("ti-eye").addClass("ti-eye-off")
            }
            else {
                input.attr("type", "password");
                $(this).removeClass("ti-eye-off").addClass("ti-eye");
            }
        });
    </script>
}
