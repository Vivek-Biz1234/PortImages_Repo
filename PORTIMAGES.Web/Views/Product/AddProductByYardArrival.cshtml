@using System.Security.Claims
@{
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}


<div class="main-content-container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
        <h5 class="mb-0" id="lblProductHeader_APBYA">Add Product By Yard Arrival</h5>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb align-items-center mb-0 lh-1">
                <li class="breadcrumb-item">
                    <a href="~/Admin/Dashboard" class="d-flex align-items-center text-decoration-none">
                        <i class="ri-home-8-line fs-15 text-primary me-1"></i>
                        <span class="text-body fs-14 hover">Dashboard</span>
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span id="spnProduct_APBYA">Add Product Yard Arrival</span>
                </li>
            </ol>
        </nav>
    </div>
    <div class="row">
        <div class="col-xxl-12 col-lg-12 col-md-12 col-12">
            <div class="card">
                <input type="hidden" id="hdnProductEncId" />
                <div class="card-header">
                    <a href="/Product/ViewProducts" class="btn btn-sm btn-primary float-end"><i class="ti ti-eye"></i>View Products</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Chassis No.<span class="text-danger"> *</span></label>
                                <input type="text" class="form-control" id="txtChassisNo_APBYA" placeholder="Chassis No.">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Shipper</label>
                                <select class="form-select form-control" id="ddlClient_APBYA" aria-label="Floating label select example">
                                </select>
                            </div>
                        </div> 
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Model</label>
                                <select class="form-select form-control" id="ddlModel_APBYA" aria-label="Floating label select example">
                                </select>
                            </div>
                        </div> 
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label class="label">Yard-In Date<span class="text-danger"> *</span></label>
                                <input type="date" class="form-control" id="txtYardInDate_APBYA" placeholder="Yard-In Date">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-xs btn-danger fw-normal text-white" id="btnClearProduct_APBYA">Clear</button>
                    <button type="button" class="btn btn-xs btn-primary fw-normal text-white" id="btnAddProduct_APBYA">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common/dropdowns.js"></script>
    <script src="~/js/common/helper.js"></script>
    <script>

        $(document).ready(function () {
            bindDropdowns();
        });

        /* ==============================
        DROPDOWNS (AJAX)
        ================================*/
        function bindDropdowns() {
            bindDropdown("USER", "#ddlClient_APBYA",null,null,0);
            bindDropdown("MODEL", "#ddlModel_APBYA",null,null,0);
        }

        /* ==============================
        VALIDATION
        ================================*/
        function validateProduct() { 
            if (!validateRequired("txtChassisNo_APBYA", ["", " "], "Chassis No is required")) return false; 
            if (!validateRequired("txtYardInDate_APBYA", ["", " "], "Yard in date is required")) return false;
            return true;
        }

        $(document).on("input change", "#txtChassisNo_APBYA,#txtYardInDate_APBYA", function () {
            $(this).removeClass("input-error");
            $(this).next(".error-text").remove();
        });

        /* ==============================
        ADD / UPDATE
        ================================*/
        $(document).on("click", "#btnAddProduct_APBYA", function () {
            if (!validateProduct()) return;
            let encId = $("#hdnProductEncId").val();
            let payload = {
                ID: 0,
                EncID: encId || null,
                ClientId: parseInt($("#ddlClient_APBYA").val()) || 0,
                ModelId: parseInt($("#ddlModel_APBYA").val()) || 0,
                ChassisNo: $("#txtChassisNo_APBYA").val().trim() || "",
                YardInDate: $("#txtYardInDate_APBYA").val()
            };
            // let _url = encId ? "/Product/UpdateProductAdditionalInfo" : "/Product/AddProductAdditionalInfo";
            let _url = "/Product/AddProductAdditionalInfo";
            $.ajax({
                url: _url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {

                    let type =
                        res.status === 1 ? "success" :
                            res.status === 2 ? "warning" : "error";

                    let title =
                        res.status === 1 ? "Success" :
                            res.status === 2 ? "Already Exists" : "Error";

                    ShowToast(type, title, res.message);

                    if (res.status === 1) {
                        // if (encId) {removeQueryString();}
                        resetForm_AddProductByYardArrival();
                    }
                }
            });

        });

        $(document).on("click", "#btnClearProduct_APBYA", function () {
            resetForm_AddProductByYardArrival();
        });

        function resetForm_AddProductByYardArrival() {
            // Clear hidden ID
            $("#hdnProductEncId").val(0);

            // Clear all text inputs
            $("#txtChassisNo_APBYA,#txtYardInDate_APBYA").val("");

            // Reset all dropdowns
            $("#ddlClient_APBYA, #ddlModel_APBYA").val("-1").trigger("chosen:updated");

            $("#lblProductHeader_APBYA").text("Add Product By Yard Arrival");
            $("#spnProduct_APBYA").text("Add Product By Yard Arrival");

            // Reset button text if using for update/add
            $("#btnAddProduct_APBYA").text("Submit");

            // Remove any error classes or messages
            $(".input-error").removeClass("input-error");
            $(".error-text").remove();

        }

    </script>
}
