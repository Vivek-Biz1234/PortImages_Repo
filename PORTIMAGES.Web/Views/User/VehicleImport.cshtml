@using System.Security.Claims
@{
    Layout = "~/Views/Shared/User/_UserLayout.cshtml";
}

<div class="main-content-container overflow-hidden">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-1">
        <div>
            <h5 class="mb-1">Import Vehicles</h5>
            <p class="text-muted mb-0 fs-13">
                Download template, fill vehicle data and upload excel file.
            </p>
        </div>
    </div>

    <div class="row">

        <!-- DOWNLOAD TEMPLATE -->
        <div class="col-12">
            <div class="table-card mb-4 p-4">

                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">

                    <div>
                        <h6 class="mb-1">Vehicle Import Template</h6>

                        <p class="text-muted mb-0 fs-13">
                            Download the excel template and fill all required vehicle details.
                        </p>
                    </div>

                    <div>
                        <a href="/Import/DownloadVehicleTemplate"
                           class="btn btn-primary">
                            <i class="ti ti-download me-1"></i>
                            Download Template
                        </a>
                    </div>

                </div>

            </div>
        </div>

        <!-- UPLOAD SECTION -->
        <div class="col-12">
            <div class="table-card mb-4 p-4">

                <div class="row">

                    <!-- FILE -->
                    <div class="col-lg-6 col-md-12">
                        <div class="mb-3">

                            <label class="label">
                                Upload Excel File
                                <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   id="fileVehicleImport"
                                   class="form-control"
                                   accept=".xlsx,.xls" />

                            <small class="text-muted">
                                Allowed formats: .xlsx, .xls
                            </small>

                        </div>
                    </div>

                    <!-- VALIDATE -->
                    <div class="col-lg-3 col-md-6">
                        <div class="mb-3 mt-4">
                            <button type="button"
                                    class="btn btn-md btn-warning"
                                    id="btnValidateVehicleImport">

                                <i class="ti ti-checkup-list me-1"></i>
                                Validate File
                            </button>
                            <button type="button"
                                    class="btn btn-md btn-success"
                                    id="btnImportVehicleData"
                                    disabled>

                                <i class="ti ti-file-import me-1"></i>
                                Import Vehicles
                            </button>
                        </div>
                    </div>


                </div>

            </div>
        </div>

        <!-- SUMMARY -->
        <div class="col-12">
            <div class="table-card mb-4 p-4">

                <div class="row text-center">

                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="border rounded p-3">

                            <h4 class="mb-1 text-primary"
                                id="lblTotalRows">
                                0
                            </h4>

                            <p class="mb-0 text-muted">
                                Total Rows
                            </p>

                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="border rounded p-3">

                            <h4 class="mb-1 text-success"
                                id="lblValidRows">
                                0
                            </h4>

                            <p class="mb-0 text-muted">
                                Valid Rows
                            </p>

                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="border rounded p-3">

                            <h4 class="mb-1 text-danger"
                                id="lblInvalidRows">
                                0
                            </h4>

                            <p class="mb-0 text-muted">
                                Invalid Rows
                            </p>

                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 col-12">
                        <div class="border rounded p-3">

                            <h4 class="mb-1 text-info"
                                id="lblDuplicateRows">
                                0
                            </h4>

                            <p class="mb-0 text-muted">
                                Duplicate Rows
                            </p>

                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- VALIDATION ERRORS -->
        <div class="col-12">

            <div class="table-card">

                

                <!-- TABLE -->
                <div class="table-responsive">

                    <table class="table align-middle w-100"
                           id="tblVehicleImportErrors">

                        <thead>
                            <tr>
                                <th>Row No</th>
                                <th>Column Name</th>
                                <th>Error Message</th>
                            </tr>
                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                </div>

                <!-- NO DATA -->
                <div class="text-center px-4 d-none"
                     id="divNoImportErrors"> 
                    <img src="~/images/no-data.png" class="w-25" /> 
                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts {
     <script src="~/js/common/helper.js"></script>
    <script src="~/js/common/import-file.js"></script>
}
