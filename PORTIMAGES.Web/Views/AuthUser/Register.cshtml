@using PORTIMAGES.Application.Auth.AuthUser.DTOs
@{
    Layout = null;
}
<meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
<meta content="IE=edge" http-equiv="X-UA-Compatible">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta content="Happy Logistics" name="description">
<meta content="Happy Logistics" name="keywords">
<meta content="Happy Logistics" name="author">
<link href="~/images/favicon.png" rel="icon" type="image/x-icon">
<title>Happy Logistics User Registration</title>
<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

<!-- tabler icons-->
<link href="~/css/tabler-icons.css" rel="stylesheet" type="text/css">

<!-- Bootstrap css-->
<link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css">

<!-- App css-->
<link href="~/css/style.css" rel="stylesheet" type="text/css">
@model UserRegistrationDTO
<form asp-action="Register" method="post">
    <div class="sign-in-bg">
        <div class="app-wrapper d-block">
            <div class="container">
                <div class="row">
                    <div class="col-12 p-0">
                        <div class="login-form-container">
                            <div class="mb-4">
                                <a class="logo" href="javascript:void(0);">
                                    <img alt="" src="~/images/logo.png" class="">
                                </a>
                            </div>
                            <div class="form_container">
                                <div class="app-form">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Full Name<span class="text-danger"> *</span></label>
                                                <input asp-for="FullName" class="form-control" id="txtFullName">
                                                <span asp-validation-for="FullName" class="error-msg"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Email address<span class="text-danger"> *</span></label>
                                                <input asp-for="Email" class="form-control" id="txtEmail">
                                                <span asp-validation-for="Email" class="error-msg"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Mobile<span class="text-danger"> *</span></label>
                                                <input asp-for="Mobile" class="form-control" id="txtMobile" maxlength="12">
                                                <span asp-validation-for="Mobile" class="error-msg"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Contact Persion</label>
                                                <input asp-for="ContactPerson" class="form-control" id="txtContactPersion">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Password<span class="text-danger"> *</span></label>
                                                <input asp-for="Password" type="password" class="form-control" value="@Model?.Password" autocomplete="new-password" />
                                                <span asp-validation-for="Password" class="error-msg"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Confirm Password<span class="text-danger"> *</span></label>
                                                <input asp-for="ConfirmPassword" type="password" class="form-control" value="@Model?.ConfirmPassword" autocomplete="new-password" />
                                                <span asp-validation-for="ConfirmPassword" class="error-msg"></span>
                                            </div>
                                        </div> 
                                        <div class="col-md-12">
                                            <div class="form-group mb-3">
                                                <label class="form-label">Address<span class="text-danger"> *</span></label>
                                                <textarea asp-for="Address" class="form-control" rows="2" id="txtAddress"></textarea>
                                                <span asp-validation-for="Address" class="error-msg"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group mb-4 form-check text-end">
                                        <a href="/AuthUser/Login" class="link-primary">SignIn?</a>
                                    </div>
                                    <div class="form-group mb-2">
                                        <button type="submit" id="btnRegister" class="btn btn-primary w-100">SignUp</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* This comment is added by vivek to check to push and commit  *@
</form>
<!-- latest jquery-->
<script src="~/js/jquery-3.6.3.min.js"></script>

<!-- Bootstrap js-->
<script src="~/js/bootstrap.bundle.min.js"></script>